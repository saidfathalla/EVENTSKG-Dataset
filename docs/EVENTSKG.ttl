@prefix conference-ontology: <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#> .
@prefix dcam: <http://purl.org/dc/dcam/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dbpedia-owl: <http://dbpedia.org/ontology/> .
@prefix eventskg: <http://w3id.org/EVENTSKG-Dataset/ekg#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix seo: <https://w3id.org/seo#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix terms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

seo:Track a owl:Class .


seo:acceptanceRate a owl:DatatypeProperty ;
    rdfs:label "acceptance rate"@en ;
    rdfs:comment "The acceptance rate of the conference expressed as a decimal factor."@en ;
    rdfs:domain conference-ontology:Conference ;
    rdfs:range xsd:float .

seo:acceptedPapers a owl:DatatypeProperty ;
    rdfs:label "accepted papers"@en ;
    rdfs:comment "The total number of accepted papers for the scientific event."@en ;
    rdfs:domain conference-ontology:Conference ;
    rdfs:range xsd:nonNegativeInteger .

seo:belongsToSeries a owl:ObjectProperty ;
    rdfs:label "belongs to series"@en ;
    rdfs:domain conference-ontology:Conference ;
    rdfs:range conference-ontology:ConferenceSeries .

seo:city a owl:ObjectProperty ;
    rdfs:label "city"@en ;
    rdfs:domain conference-ontology:Conference ;
    rdfs:range terms:Location .

seo:eventWebsite owl:equivalentProperty <http://schema.org/url> .

seo:ResearchField a owl:ObjectProperty .

seo:heldInCountry a owl:ObjectProperty ;
    rdfs:label "held in country"@en ;
    rdfs:domain conference-ontology:Conference ;
    rdfs:range terms:Location .

dbpedia-owl:state a owl:ObjectProperty .

seo:submittedPapers a owl:DatatypeProperty ;
    rdfs:label "submitted papers"@en ;
    rdfs:comment "The total number of submitted papers to the scientific event."@en ;
    rdfs:domain conference-ontology:Conference ;
    rdfs:range xsd:nonNegativeInteger .

