@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix seo: <https://w3id.org/seo#> .
@prefix co: <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix schema: <http://schema.org/> .
@prefix ekgs: <http://w3id.org/EVENTSKG-Dataset/shapes#> .

ekgs:EventShape a sh:NodeShape ;
  sh:targetSubjectsOf seo:belongsToSeries ;
  sh:property [ sh:path seo:belongsToSeries ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
                sh:message "every event belongs to exactly one series" ] ;
  sh:property [ sh:path co:acronym ; sh:minCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path co:startDate ; sh:maxCount 1 ; sh:datatype xsd:dateTime ; sh:severity sh:Warning ] ;
  sh:property [ sh:path co:endDate ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
  # Start must not be after end. Checked per event on the two values, so neither the order of the
  # triples in the file nor the order of the properties matters; events with only one date are not checked.
  sh:sparql [ a sh:SPARQLConstraint ;
      sh:severity sh:Warning ;
      sh:message "start date {?start} is after end date {?end}" ;
      sh:select """
        SELECT $this ?start ?end WHERE {
          $this <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#startDate> ?start ;
                <https://w3id.org/scholarlydata/ontology/conference-ontology.owl#endDate>   ?end .
          FILTER (?start > ?end)
        }""" ] ;
  sh:property [ sh:path seo:submittedPapers ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] ;
  sh:property [ sh:path seo:acceptedPapers ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ;
                sh:lessThanOrEquals seo:submittedPapers ; sh:message "accepted papers cannot exceed submitted papers" ] ;
  sh:property [ sh:path seo:acceptanceRate ; sh:maxCount 1 ; sh:datatype xsd:decimal ;
                sh:minInclusive 0 ; sh:maxInclusive 1 ] ;
  sh:property [ sh:path seo:heldInCountry ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path seo:city ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path dbo:state ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path seo:ResearchField ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:severity sh:Warning ] ;
  sh:property [ sh:path schema:eventAttendanceMode ; sh:maxCount 1 ;
                sh:in ( schema:OnlineEventAttendanceMode schema:MixedEventAttendanceMode schema:OfflineEventAttendanceMode ) ] ;
  sh:property [ sh:path schema:eventStatus ; sh:maxCount 1 ; sh:in ( schema:EventScheduled schema:EventCancelled schema:EventPostponed schema:EventRescheduled schema:EventMovedOnline ) ] .

ekgs:SeriesShape a sh:NodeShape ;
  sh:targetObjectsOf seo:belongsToSeries ;
  sh:property [ sh:path co:acronym ; sh:minCount 1 ] .
