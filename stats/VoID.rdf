    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-28</dcterms:issued>
    <owl:versionInfo>3.0</owl:versionInfo>
    <prov:wasRevisionOf rdf:resource="https://github.com/saidfathalla/EVENTSKG-Dataset/blob/master/EVENTSKG.ttl"/>
    <vann:preferredNamespacePrefix>eventskg</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>http://w3id.org/EVENTSKG-Dataset/ekg#</vann:preferredNamespaceUri>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-28</dcterms:modified>
