  <rdf:Description rdf:nodeID="n4cd443215e144210b511619c18d186c6b14">
    <rdf:type rdf:resource="http://purl.org/dc/terms/ProvenanceStatement"/>
    <dcterms:source rdf:resource="https://raw.githubusercontent.com/saidfathalla/EVENTSKG-Dataset/master/provenance/migration_log.csv"/>
    <dcterms:source rdf:resource="https://raw.githubusercontent.com/saidfathalla/EVENTSKG-Dataset/master/provenance/fix_log.csv"/>
    <dcterms:source rdf:resource="https://raw.githubusercontent.com/saidfathalla/EVENTSKG-Dataset/master/provenance/data_checks.csv"/>
    <dcterms:description xml:lang="en">Release 3.0 was created by merging release 2.1 with a curated spreadsheet and by researching the editions held after 2018 from event web sites and proceedings. Every change to a value of release 2.1 is logged with its old value, new value and reason in the migration and correction logs; open data-quality items are listed in the data-check report. Sources of individual values are not yet recorded.</dcterms:description>
  </rdf:Description>
