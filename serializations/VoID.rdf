    <rdfs:label xml:lang="en">EVENTSKG, A dataset of scientific events</rdfs:label>
    <dcterms:title xml:lang="en">EVENTSKG, Scientific Events Knowledge Graph.</dcterms:title>
    <dcterms:description xml:lang="en">EVENTSKG release 3.0: metadata of 2531 events of 75 top-ranked computer-science event series (1969-2026): dates, location, homepage, submitted/accepted papers and acceptance rate, research field, publisher and sponsor.</dcterms:description>
    <dcterms:creator rdf:resource="https://orcid.org/0000-0002-2818-5890"/>
    <dcterms:license rdf:resource="http://creativecommons.org/licenses/by/4.0/"/>
