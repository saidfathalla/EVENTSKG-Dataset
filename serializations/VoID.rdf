    <owl:versionInfo>3.0</owl:versionInfo>
    <prov:wasRevisionOf rdf:resource="https://raw.githubusercontent.com/saidfathalla/EVENTSKG-Dataset/master/archive/R2.1/EVENTSKG.ttl"/>
