  {
   "@id": "_:n38789c95af504e04b62bf67fc20eab26b14",
   "@type": "dcterms:ProvenanceStatement",
   "dcterms:description": {
    "@language": "en",
    "@value": "Release 3.0 was created by merging release 2.1 with a curated spreadsheet and by researching the editions held after 2018 from event web sites and proceedings. Every change to a value of release 2.1 is logged with its old value, new value and reason in the migration and correction logs; open data-quality items are listed in the data-check report. Sources of individual values are not yet recorded."
   },
   "dcterms:source": [
    {
     "@id": "https://raw.githubusercontent.com/saidfathalla/EVENTSKG-Dataset/master/provenance/data_checks.csv"
    },
    {
     "@id": "https://raw.githubusercontent.com/saidfathalla/EVENTSKG-Dataset/master/provenance/migration_log.csv"
    },
    {
     "@id": "https://raw.githubusercontent.com/saidfathalla/EVENTSKG-Dataset/master/provenance/fix_log.csv"
    }
   ]
  },
