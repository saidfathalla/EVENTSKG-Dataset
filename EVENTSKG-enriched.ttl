    dcterms:license <http://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-10-30"^^xsd:date ;
    dcterms:title "EVENTSKG, Scientific Events Knowledge Graph."@en ;
    vann:preferredNamespacePrefix "eventskg" ;
    vann:preferredNamespaceUri "http://w3id.org/EVENTSKG-Dataset/ekg#" ;
    void:classes 27 ;
    void:distinctObjects 14229 ;
    void:distinctSubjects 3287 ;
    void:entities 3287 ;
    void:feature <http://www.w3.org/ns/formats/JSON-LD>,
        <http://www.w3.org/ns/formats/N-Triples>,
        <http://www.w3.org/ns/formats/N3>,
        <http://www.w3.org/ns/formats/RDF_XML>,
        <http://www.w3.org/ns/formats/Turtle> ;
    void:properties 41 ;
    void:triples 44059 ;
    owl:versionInfo "3.0" ;
    prov:wasRevisionOf <https://raw.githubusercontent.com/saidfathalla/EVENTSKG-Dataset/master/archive/R2.1/EVENTSKG.ttl> .

